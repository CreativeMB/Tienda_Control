<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <RelativeLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <EditText
            android:id="@+id/inputValor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:hint="Precio"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:nextFocusDown="@id/inputNombre"
            android:textSize="70dp" />

        <FrameLayout
            android:id="@+id/containerNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/inputValor"
            android:layout_marginTop="10dp">

            <!-- TextView de sugerencia -->
            <TextView
                android:id="@+id/tvSugerencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:singleLine="true"
                android:textColor="#8E8E8E"
                android:textSize="50sp"
                android:padding="0dp"
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                android:visibility="gone" />

            <!-- EditText principal -->
            <EditText
                android:id="@+id/inputNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Nombre"
                android:imeOptions="actionNext"
                android:inputType="text"
                android:singleLine="true"
                android:textSize="50sp"
                android:padding="0dp"
                android:includeFontPadding="false"
                android:gravity="center_vertical"
                android:nextFocusUp="@id/inputValor"
                android:nextFocusDown="@id/switchTipo"/>
        </FrameLayout>



        <Switch
            android:id="@+id/switchTipo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/containerNombre"
            android:layout_marginTop="10dp"
            android:imeOptions="actionNext"
            android:nextFocusUp="@id/inputNombre"
            android:nextFocusDown="@id/inputNota"
            android:text="¿Es un gasto (negativo)?" />

        <EditText
            android:id="@+id/inputNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/switchTipo"
            android:layout_marginTop="10dp"
            android:hint="Nota"
            android:imeOptions="actionNext"
            android:inputType="textMultiLine"
            android:nextFocusUp="@id/switchTipo"
            android:nextFocusDown="@id/inputGuardar" />

        <TextView
            android:id="@+id/inputGuardar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/inputNota"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:background="@drawable/selector_background"
            android:clickable="true"
            android:focusable="true"
            android:foregroundGravity="center"
            android:gravity="center"
            android:padding="10dp"
            android:text="Guardar"
            android:textSize="18sp" />

    </RelativeLayout>
</ScrollView>
