<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MisDatos">

    <LinearLayout
        android:id="@+id/layout_encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_background"
        android:orientation="horizontal"
        tools:ignore="MissingConstraints">

        <TextView
            android:id="@+id/Venta"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Nuevo Producto"
            android:textSize="25dp"
            android:padding="5dp"
            android:gravity="center"
            android:background="@drawable/selector_background" />

        <Spinner
            android:id="@+id/spinner_filtro"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:minHeight="48dp"
            android:paddingHorizontal="16dp"
            android:background="@drawable/selector_background"
            style="@style/SpinnerPersonalisado" />

    </LinearLayout>



    <!-- RecyclerView para mostrar productos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewProductos"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/layout_encabezado"
        app:layout_constraintBottom_toTopOf="@id/layout_totales"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/layoutMensajeVacio"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="25dp">

        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/donar" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No hay ítems en esta vista. Prueba cambiar el filtro o agrega un nuevo registro para comenzar a controlar tus finanzas.\n\n¡Empieza ahora y verás tus resultados aquí!"
            android:textSize="20sp"
            android:gravity="center"
            android:layout_marginTop="16dp"/>

    </LinearLayout>

    <!-- Contenedor flotante para ingresos, egresos y diferencia -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_totales"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/selector_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="8dp">

        <!-- Diferencia en una sola línea -->
        <TextView
            android:id="@+id/textDiferencia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Diferencia: $0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Contenedor para ingresos y egresos en la misma línea -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/textDiferencia"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/textIngresos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ingresos: $0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:id="@+id/textEgresos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Egresos: $0"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
