<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/database"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/database"
            android:contentDescription="Ícono base de datos" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¡Apóyanos con tu donación!"
            android:textSize="26sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Gracias por confiar en Tienda Control para llevar la contabilidad de tu negocio. Tu apoyo es muy importante para que podamos seguir mejorando la aplicación y brindarte nuevas herramientas que faciliten tu gestión financiera."
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/instructions_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="sans-serif-medium"
            android:text="¿Cómo donar?"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/instructions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Abre la aplicación de tu banco.\n2. Busca la opción para hacer transferencias por llave.\n3. Ingresa la llave:"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:fontFamily="sans-serif"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@TMB833"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            android:background="@drawable/selector_background"
            android:padding="12dp"
            android:layout_marginBottom="24dp"
            android:gravity="center_horizontal"
            android:clickable="true"
            android:focusable="true"/>


        <TextView
            android:id="@+id/instruction_final"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Realiza la transferencia por el monto que desees.\n\nCada donación, por pequeña que sea, nos ayuda a crecer y ofrecer un mejor servicio.\n\n¡Gracias por ser parte de Tienda Control!"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:fontFamily="sans-serif"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>
