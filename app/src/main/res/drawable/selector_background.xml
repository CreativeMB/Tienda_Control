<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#FFD600"
                        android:endColor="#D50000"
                        android:angle="90" />
                    <corners android:radius="5dp" />
                    <size android:width="200dp"
                        android:height="40dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#C51162"
                        android:endColor="#FFAB00"
                        android:angle="90" />
                    <corners android:radius="5dp" />
                    <size android:width="200dp"
                        android:height="40dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#0054E0"
                        android:endColor="#3FA46C"
                        android:angle="90" />
                    <corners android:radius="5dp" />
                    <size android:width="200dp"
                        android:height="40dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>